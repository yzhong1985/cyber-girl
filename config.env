# ===================== cyber girl 配置 =====================
# 所有常调设置集中在这里。改完保存, 重启对应脚本生效:
#     bash stop.sh && bash start_avatar.sh      (真人形象版)
#     bash stop.sh && bash start_live2d.sh      (Live2D 版)
#
# 语法: 纯 KEY=VALUE, 等号两边不要空格; 值里含空格/反斜杠请用单引号。
# 不想改的项留着即可; 整个文件删了也能跑(脚本内有同样的默认值)。
# 命令行参数(如 start_avatar.sh --skip-mask)优先级高于本文件。
# ===========================================================

# ---------- 角色 ----------
# 用 speech-to-speech/characters.json 里的哪个角色。角色的性格/回复长度在那个文件里改。
PERSONA=xiaoman                 # xiaoman(温柔) / linlin(冷淡)

# ---------- 数字人形象 (仅 start_avatar.sh) ----------
AVATAR_PHOTO=avatar/girl.png    # 照片路径(相对 ditto-talkinghead/); 换脸就改这里
AVATAR_MATTE=0                  # 1=抠图合成到背景(好看,慢)  0=用照片原背景(快~40%)
AVATAR_BACKEND=onnx             # onnx=混合onnxruntime后端(快~20%,默认) / pytorch=全PyTorch(排障用)
AVATAR_COMPILE_WARP=1           # 1=warp_network套torch.compile再提速~30%(默认,首次启动多等~70s) / 0=关(排障用)
AVATAR_COMPILE_LMDM=1           # 1=lmdm套torch.compile再提速~60%(默认,首次启动多等~70s,与上面共用一次预热) / 0=关(排障用)
AVATAR_FILLER=1                 # 1=说完话过渡语占位,真实回复后台并行生成(默认) / 0=关(排障用)
AVATAR_FILLER_DELAY_MIN=1.6     # 过渡语延迟播放的最短秒数(模拟人反应停顿,别一停嘴就抢答)
AVATAR_FILLER_DELAY_MAX=2.6     # 最长秒数,实际每次在这区间随机,别每次一个节奏

# ---------- 语音识别 STT ----------
STT_MODEL=openai/whisper-large-v3-turbo
STT_LANGUAGE=zh                 # 固定识别语言 zh/en/ja...; auto=自动检测(可能偶尔猜错)

# ---------- 断句灵敏度 VAD ----------
VAD_THRESH=0.4                  # 0~1, 越低越灵敏(易触发), 越高越要求清晰大声
MIN_SPEECH_MS=300               # 短于此的声音不算说话(滤掉咳嗽/杂音)
MIN_SILENCE_MS=500              # 静默超过此判定一句结束; 越小切句越快, 太小会把你说话切断

# ---------- 大语言模型 LLM ----------
LLM_MODEL=qwen3-14b-q6          # llama-server 的模型别名(-a), 要和 GGUF 对应
LLM_GGUF='E:\Projects\cyberGirl\speech-to-speech\models\llm\Qwen3-14B-Q6_K.gguf'
LLM_CTX=8192                    # 上下文长度(token)

# ---------- 网页版 (仅 start_avatar.sh --web 或 WEB_MODE=1) ----------
WEB_MODE=0                      # 1=浏览器采麦(WebSocket)+自签HTTPS, 供局域网设备用自己麦克风; 0=本机麦克风(默认)
WS_PORT=8765                    # 语音管线 WebSocket 端口; 局域网访问需要额外的 netsh portproxy(见启动时打印的提示)
